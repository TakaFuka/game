{
  "variables": {
    "rest": 0,
    "needtime": 0,
    "stroke": 1,
    "dice": 1
  },

  "screens": [

    {
      "id": "start01",
      "type": "start",

      "showScreenTime": false,

      "counter": {
        "type": "none"
      },

      "text": "開始します",

      "buttons": [
        {
          "label": "開始",

          "visibleCondition": {
            "type": "immediate"
          },

          "transition": {
            "type": "fixed",
            "target": "rest01"
          }
        }
      ]
    },

    {
      "id": "rest01",
      "type": "rest",

      "showScreenTime": true,

      "counter": {
        "type": "none"
      },

      "text": "マス数を選択してください",

      "buttons": [

        {
          "label": "15",

          "visibleCondition": {
            "type": "immediate"
          },

          "variableChanges": [
            {
              "name": "rest",
              "value": 15
            }
          ],

          "transition": {
            "type": "random",
            "pool": ["count01"]
          }
        },

        {
          "label": "30",

          "visibleCondition": {
            "type": "immediate"
          },

          "variableChanges": [
            {
              "name": "rest",
              "value": 30
            }
          ],

          "transition": {
            "type": "random",
            "pool":["task","stroke","count"] 
          }
        },

        {
          "label": "50",

          "visibleCondition": {
            "type": "immediate"
          },

          "variableChanges": [
            {
              "name": "rest",
              "value": 50
            }
          ],

          "transition": {
            "type": "random",
            "pool": ["task","stroke","count"]
          }
        },

        {
          "label": "80",

          "visibleCondition": {
            "type": "immediate"
          },

          "variableChanges": [
            {
              "name": "rest",
              "value": 80
            }
          ],

          "transition": {
            "type": "random",
            "pool": ["task","stroke","count"]
          }
        },

        {
          "label": "100",

          "visibleCondition": {
            "type": "immediate"
          },

          "variableChanges": [
            {
              "name": "rest",
              "value": 100
            }
          ],

          "transition": {
            "type": "random",
            "pool": ["task","stroke","count"]
          }
        }
      ]
    
    },

    {
      "id": "task01",
      "type": "task",

      "defaultWeight": 1,

      "showScreenTime": false,

      "variableChanges": [

        {
          "name": "needtime",
          "value": "[15,15,15,15,15,15,15,15,15,30,30,30,30,30,30,30,30,45,45,45,60,60,120][Math.floor(Math.random()*23)]"
        },

        {
          "name": "stroke",
          "value": "1+Math.random()"
        }

      ],

      "counter": {

        "type": "countup",
        
        "start": "Math.floor(Math.random()*20)",

        "interval": "stroke"

      },

      "text": "{needtime}秒～{Math.floor(needtime*1.6)}秒のストローク",

      "buttons": [

        {

          "label": "進む",

          "visibleCondition": {

            "type": "immediate"

          },

          "transition": {

            "type": "random",

            "pool": [
              "rest02",
              "rest03"
            ],

            "weights": {

              "rest02": "Math.min(screenElapsed-needtime+1,Math.floor(needtime*1.6-screenElapsed))+1",

              "rest03": "Math.max(needtime-screenElapsed,Math.floor(screenElapsed-needtime*1.6))"

            }

          }

        }

      ]

    },

    {
      "id": "task02",
      "type": "task",

      "defaultWeight": 1,

      "showScreenTime": false,

      "variableChanges": [

        {

          "name": "needtime",

          "value": "[15,15,15,15,15,15,15,15,15,30,30,30,30,30,30,45,45,45,45,60][Math.floor(Math.random()*20)]"

        },

        {

          "name": "stroke",

          "value": "0.6+Math.random()*0.2"

        }

      ],

      "counter": {

        "type": "countup",
        
        "start": "Math.floor(Math.random()*20)",

        "interval": "stroke"

      },

      "text": "{needtime}秒～{Math.floor(needtime*1.5)}秒のストローク",

      "buttons": [

        {

          "label": "進む",

          "visibleCondition": {

            "type": "immediate"

          },

          "transition": {

            "type": "random",

            "pool": [
              "rest02",
              "rest03"
            ],

            "weights": {

              "rest02": "Math.min(screenElapsed-needtime+1,Math.floor(needtime*1.5-screenElapsed))+1",

              "rest03": "Math.max(needtime-screenElapsed,Math.floor(screenElapsed-needtime*1.5))"

            }

          }

        }

      ]

    },

    {
      "id": "task03",
      "type": "task",

      "defaultWeight": 1,

      "showScreenTime": false,

      "variableChanges": [

        {

          "name": "needtime",

          "value": "[15,15,15,15,15,15,15,15,15,30,30,30,30,30,30,45,45][Math.floor(Math.random()*17)]"

        },

        {

          "name": "stroke",

          "value": "0.2+Math.random()*0.3"

        }

      ],

      "counter": {

        "type": "countup",
        
        "start": "Math.floor(Math.random()*20)",

        "interval": "stroke"

      },

      "text": "{needtime}秒～{Math.floor(needtime*1.3)}秒のストローク",

      "buttons": [

        {

          "label": "進む",

          "visibleCondition": {

            "type": "immediate"

          },

          "transition": {

            "type": "random",

            "pool": [
              "rest02",
              "rest03"
            ],

            "weights": {

              "rest02": "Math.min(screenElapsed-needtime+1,Math.floor(needtime*1.3-screenElapsed))+1",

              "rest03": "Math.max(needtime-screenElapsed,Math.floor(screenElapsed-needtime*1.3))"

            }

          }

        }

      ]

    },

    {
      "id": "rest02",

      "type": "rest",

      "showScreenTime": true,

      "variableChanges": [

        {

          "name": "dice",

          "value": "Math.floor(Math.random()*6)+1+Math.ceil(needtime/30)"

        },

        {

          "name": "rest",

          "value": "rest-dice"

        }

      ],

      "counter": {

        "type": "countdown",

        "start": "Math.ceil(needtime/3)+10",

        "interval": 1

      },

      "text": "成功：{previousScreenElapsed}秒\n{dice}マス進む。残り{rest}マス",

      "buttons": [

        {

          "label": "進む",

          "visibleCondition": {

            "type": "immediate"

          },

          "transition": {

            "type": "random",

            "pool": [

              "task","stroke","count",

              "end"

            ],

            "weights": {

              "end01": "-(rest-1)*1000"

            }

          }

        }

      ],

      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

          "type": "random",

          "pool": [

            "task",
            "stroke",
            "count",

            "end"

          ],

          "weights": {

            "end01": "-(rest-1)"

          }

        }

      }

    },

    
    {
      "id": "rest03",

      "type": "rest",

      "showScreenTime": true,
      
      "variableChanges": [

        {

          "name": "dice",

          "value": "Math.floor(Math.random()*3)+1+Math.ceil((180-needtime)/60)"

        },

        {

          "name": "rest",

          "value": "rest+dice"

        }

      ],

      "counter": {

        "type": "countdown",

        "start": "Math.ceil(needtime/3)+10",

        "interval": 1

      },

      "text": "失敗：{previousScreenElapsed}秒\n{dice}マス戻る。残り{rest}マス",

      "buttons": [

        {

          "label": "進む",

          "visibleCondition": {

            "type": "immediate"

          },

          "transition": {

            "type": "random",

            "pool": [

              "task",
              "stroke",
              "count"

            ],

            "weights": {

              "end01": "-(rest-1)"

            }

          }

        }

      ],

      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

          "type": "random",

          "pool": ["task","stroke","count"]

        }

      }

    },



    {
        "id": "stroke01",
        "type": "stroke",
        "defaultWeight": 0.8,
        "showScreenTime": true,
        "variableChanges": [

        {
          "name": "needtime",

          "value": "10"
        },

        {
          "name": "stroke",
          "value": "1+Math.random()"
        }

      ],
        "counter": {
            "type": "countdown",
            "start": "Math.floor(Math.random()*3+1)*30-10+Math.floor(Math.random()*Math.floor(rest / Math.pow(10, Math.floor(Math.log10(rest))))/2)*10",
            "interval": "[0.5,0.8,1][Math.floor(Math.random()*3)]"
        },
        "text": "strokeチャレンジ",

      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

            "type": "fixed",
            "target": "rest02"

        }

      }
    },
    {
        "id": "stroke02",
        "type": "stroke",
        "defaultWeight": 1,
        "showScreenTime": true,
              "variableChanges": [

        {
          "name": "needtime",

          "value": "20"
        },

        {
          "name": "stroke",
          "value": "1+Math.random()"
        }

      ],
        "counter": {
            "type": "countdown",
            "start": "Math.floor(Math.random()*3+1)*20-10+Math.floor(Math.random()*Math.floor(rest / Math.pow(10, Math.floor(Math.log10(rest))))/3)*10",
            "interval": "[0.3,0.4,0.5][Math.floor(Math.random()*3)]"
        },
        "text": "strokeチャレンジ：速い",
      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

            "type": "fixed",
            "target": "rest02"

        }

      }
    },
    {
        "id": "stroke03",
        "type": "stroke",
        "defaultWeight": 0.5,
        "showScreenTime": true,
              "variableChanges": [

        {
          "name": "needtime",
          "value": "30"
        },

        {
          "name": "stroke",
          "value": "1+Math.random()"
        }

      ],
        "counter": {
            "type": "countdown",
            "start": "Math.floor(Math.random()*2+1)*20-10+Math.floor(Math.random()*Math.floor(rest / Math.pow(10, Math.floor(Math.log10(rest))))/3)*10",
            "interval": "[0.2,0.25,0.3][Math.floor(Math.random()*3)]"
        },
        "text": "strokeチャレンジ：とても速い",
      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

            "type": "fixed",
            "target": "rest02"

        }

      }
    },




    
    {
        "id": "count01",
        "type": "count",
        "defaultWeight": 0.8,
        "showScreenTime": true,
        "variableChanges": [

        {
          "name": "needtime",

          "value": "(Math.floor(Math.random()*4)+1)*30/30"
        },
        
        {
          "name": "stroke",

          "value": "Math.floor(30*(Math.random()*1+1)/10)*10"
        }

      ],
        "counter": {
            "type": "timer",
            "duration": "needtime"
        },
        "text": "{needtime}以内に{stroke*Math.ceil((screenElapsed+1)/30)}",

      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

            "type": "fixed",
            "target": "rest03"

        }

      },
      
      "buttons": [

        {
          "label": "達成",

          "visibleCondition": {
            "type": "immediate"
          },

          "transition": {
            "type": "fixed",
            "target": "rest02"
          }
        }
      ]

    },
    
    {
        "id": "count02",
        "type": "count",
        "defaultWeight": 0.5,
        "showScreenTime": true,
        "variableChanges": [

        {
          "name": "needtime",

          "value": "(Math.floor(Math.random()*3)+2)*30"
        },
        

        {
          "name": "stroke",

          "value": "Math.floor(30*(Math.random()*2+1)/10)*10"
        },
        {
          "name": "dice",

          "value": "Math.random()*0.3+1"
        }

      ],
        "counter": {
            "type": "timer",
            "duration": "needtime"
        },
        "text": "{needtime}以内に{stroke + Math.floor(stroke*dice*(Math.ceil((screenElapsed+1)/30)-1)/10)*10}",

      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

            "type": "fixed",
            "target": "rest03"

        }

      },
      
      "buttons": [

        {
          "label": "達成",

          "visibleCondition": {
            "type": "immediate"
          },

          "transition": {
            "type": "fixed",
            "target": "rest02"
          }
        }
      ]

    },
    {
        "id": "count03",
        "type": "count",
        "defaultWeight": 0.4,
        "showScreenTime": true,
        "variableChanges": [

        {
          "name": "needtime",

          "value": "(Math.floor(Math.random()*3)+2)*30"
        },
        
 

        {
          "name": "stroke",

          "value": "Math.floor(30*(Math.random()*1+2)/10)*10"
        },
        {
          "name": "dice",

          "value": "Math.random()*0.4+1.1"
        }

      ],
        "counter": {
            "type": "timer",
            "duration": "needtime"
        },
        "text": "{needtime}以内に{stroke + Math.floor(stroke*dice*(Math.ceil((screenElapsed+1)/30)-1)/10)*10}",


      "autoTransition": {

        "condition": {

          "type": "value",

          "variable": "counterValue",

          "operator": "<=",

          "value": 0

        },

        "transition": {

            "type": "fixed",
            "target": "rest03"

        }

      },
      
      "buttons": [

        {
          "label": "達成",

          "visibleCondition": {
            "type": "immediate"
          },

          "transition": {
            "type": "fixed",
            "target": "rest02"
          }
        }
      ]

    },

    {
      "id": "end01",

      "type": "end",

      "showScreenTime": true,

      "counter": {

        "type": "countup",

        "interval": "1/(screenElapsed/20+1)"

      },

      "text": "クリア",

      "buttons": [

        {

          "label": "開始画面へ",

          "visibleCondition": {

            "type": "immediate"

          },

          "transition": {

            "type": "fixed",

            "target": "start01"

          }

        }

      ]

    }

  ]
}